<Project>
  <!-- Central Package Management: every package version for the monorepo lives here. -->
  <!-- Individual .csproj files reference packages WITHOUT a Version attribute. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="CQRS">
    <!-- MediatR 12.5.0 is the last Apache-2.0 (free) release; 13+ requires a commercial licence. -->
    <PackageVersion Include="MediatR" Version="12.5.0" />
    <PackageVersion Include="MailKit" Version="4.18.1" />
    <!-- Transitive via Testcontainers (test projects only); pinned past GHSA-q939-rpr3-3284 and GHSA-mggc-4xg6-vcxf (GL-42). -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="Microsoft.SemanticKernel.Core" Version="1.78.0" />
  </ItemGroup>
  <ItemGroup Label="Validation">
    <PackageVersion Include="FluentValidation" Version="11.11.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="11.11.0" />
  </ItemGroup>
  <ItemGroup Label="Identity / JWT">
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.2" />
  </ItemGroup>
  <ItemGroup Label="Messaging (bus)">
    <!-- MassTransit 8.x is Apache-2.0 (free); 9+ requires a commercial licence. -->
    <PackageVersion Include="MassTransit" Version="8.5.10" />
    <PackageVersion Include="MassTransit.RabbitMQ" Version="8.5.10" />
    <PackageVersion Include="MassTransit.EntityFrameworkCore" Version="8.5.10" />
  </ItemGroup>
  <ItemGroup Label="Persistence (Postgres + EF Core)">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.4.6" />
  </ItemGroup>
  <ItemGroup Label="Blob storage (S3 / MinIO)">
    <PackageVersion Include="AWSSDK.S3" Version="4.0.101.3" />
  </ItemGroup>
  <ItemGroup Label="HTTP (Twilio gateway)">
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.8" />
  </ItemGroup>
  <ItemGroup Label="Generic host (Trustli.Migration console runner)">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup Label="OCR ingestion (Trustli.Ocr.Ingestion)">
    <PackageVersion Include="Azure.AI.DocumentIntelligence" Version="1.0.0" />
    <PackageVersion Include="Tesseract" Version="5.2.0" />
    <PackageVersion Include="PDFtoImage" Version="5.2.1" />
  </ItemGroup>

  <ItemGroup Label="AI (Semantic Kernel — Infrastructure only; the architecture test polices the boundary)">
    <PackageVersion Include="Microsoft.SemanticKernel" Version="1.30.0" />
  </ItemGroup>
  <ItemGroup Label="Report deliverable rendering (Infrastructure only) — PDF + QR">
    <PackageVersion Include="QuestPDF" Version="2024.12.3" />
    <PackageVersion Include="QRCoder" Version="1.6.0" />
  </ItemGroup>
  <ItemGroup Label="Web API">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <!-- Scalar renders the OpenAPI document as interactive API reference docs (replaces Swagger UI). -->
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.15" />
    <!-- Transitively pinned to patch GHSA-v5pm-xwqc-g5wc (Microsoft.OpenApi 2.0.0). -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.11.0" />
  </ItemGroup>
  <ItemGroup Label="Aspire hosting (AppHost)">
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.RabbitMQ" Version="13.4.6" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.Minio" Version="13.4.0" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.MailPit" Version="13.4.0" />
  </ItemGroup>
  <ItemGroup Label="Aspire service defaults">
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.6.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.6.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.1" />
  </ItemGroup>
  <ItemGroup Label="DI + configuration (concrete container / connection strings — used by ConfidencePassport)">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.10" />
  </ItemGroup>
  <ItemGroup Label="Testing (xUnit)">
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="3.10.0" />
    <PackageVersion Include="Testcontainers.Minio" Version="3.10.0" />
  </ItemGroup>
</Project>