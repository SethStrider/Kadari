# KADARI production environment. Copy to deploy/.env (never committed), fill in every value, and keep a copy of
# the whole file in the team password manager. Generate each secret with:  openssl rand -base64 48
#
# Two custodians for everything below. FIELD_ENCRYPTION_KEY and BACKUP_ENCRYPTION_PASSWORD/_SALT also get a sealed
# offline copy: lose the first and every encrypted field and stored photo is unreadable; lose the second and backups are useless.

# --- Deployment -----------------------------------------------------------------------------------------------
KADARI_DOMAIN=kadari.co.za
GIT_SHA=
# MinIO server image (pinned; the same image runs the one-shot bucket setup). MinIO no longer publishes free images
# (minio/minio is gone from Docker Hub and quay.io), so this is our own mirror of the last release we tested, kept in
# the mccarthyfam GitLab registry. The server needs `docker login registry.gitlab.com` once (see deploy/README.md).
# Offline copy: D:\Work\image-backups\minio-RELEASE.2025-09-07T16-13-09Z.tar (docker load -i ...).
MINIO_IMAGE=registry.gitlab.com/mccarthyfam/trustli/minio:RELEASE.2025-09-07T16-13-09Z

# --- Data-protecting secrets (validated at boot: >= 32 bytes, never the committed development values) ----------
JWT_SIGNING_KEY=
FIELD_ENCRYPTION_KEY=
# Field-encryption key rotation (GL-24). Every ciphertext names the key id that wrote it. To rotate:
#   1. move the current FIELD_ENCRYPTION_KEY and its id into FIELD_ENCRYPTION_RETIRED_KEY / _RETIRED_KEY_ID;
#   2. set a new FIELD_ENCRYPTION_KEY and a new FIELD_ENCRYPTION_KEY_ID (e.g. 2); redeploy;
#   3. docker compose -f deploy/docker-compose.prod.yml run --rm migrations --migrate-only --reencrypt-fields
#      (a non-zero exit means some value no configured key can read: do not drop the old key);
#   4. keep the retired key: every stored file's own key is wrapped by it (files are not re-encrypted).
FIELD_ENCRYPTION_KEY_ID=1
FIELD_ENCRYPTION_RETIRED_KEY_ID=
FIELD_ENCRYPTION_RETIRED_KEY=
IDENTITY_HASH_SECRET=
REPORT_INTEGRITY_KEY=
REPORT_MEDIA_KEY=

# --- PostgreSQL (three roles: superuser for nobody, migrator owns the schema, app reads/writes rows) ------------
DB_SUPERUSER_PASSWORD=
DB_MIGRATOR_PASSWORD=
DB_APP_PASSWORD=

# --- RabbitMQ (the outbox's broker; the API publishes, the worker consumes) -------------------------------------
RABBITMQ_PASSWORD=

# --- MinIO ----------------------------------------------------------------------------------------------------
MINIO_ROOT_USER=kadari-root
MINIO_ROOT_PASSWORD=
MINIO_APP_USER=kadari-app
MINIO_APP_PASSWORD=

# --- First administrator (seeded by the migrations job; signs in by OTP) ----------------------------------------
ADMIN_MOBILE=+27
ADMIN_EMAIL=

# --- Twilio: sign-in codes by SMS or WhatsApp ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+27
# Approved WhatsApp Authentication template (HX...). Empty = OTP goes by SMS from TWILIO_SMS_FROM.
TWILIO_OTP_CONTENT_SID=
TWILIO_SMS_FROM=KADARI

# --- Email: SMTP submission with TLS (GL-10) --------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=StartTls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@mail.kadari.co.za

# --- Optional -----------------------------------------------------------------------------------------------------
# Vision model for capture: PassThrough | Gemini | OpenAiCompatible. Gemini must be a paid-tier key (no training on inputs).
VISION_PROVIDER=PassThrough
GEMINI_API_KEY=
# Only when VISION_PROVIDER=OpenAiCompatible (Groq, OpenRouter, ...).
OPENAI_VISION_BASE_URL=
OPENAI_VISION_MODEL=
OPENAI_VISION_API_KEY=
# Telemetry to Grafana Cloud (or any OTLP endpoint).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# --- Backups (GL-08): an S3-compatible bucket at a DIFFERENT provider from the VPS -------------------------------
# OFFSITE_PROVIDER is rclone's S3 provider name: AWS, Cloudflare, Backblaze (B2's S3 API), Wasabi, Other ...
OFFSITE_PROVIDER=
OFFSITE_ENDPOINT=
OFFSITE_REGION=auto
OFFSITE_BUCKET=
OFFSITE_ACCESS_KEY_ID=
OFFSITE_SECRET_ACCESS_KEY=
BACKUP_ENCRYPTION_PASSWORD=
BACKUP_ENCRYPTION_SALT=
BACKUP_HOUR_UTC=0
BACKUP_RETENTION_DAYS=30
# A dead-man's-switch URL pinged after each successful backup (e.g. healthchecks.io). Strongly recommended.
BACKUP_HEARTBEAT_URL=
