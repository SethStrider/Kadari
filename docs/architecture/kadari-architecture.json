  "cards": [
    {
      "dot": "cyan",
      "title": "Three audiences",
      "items": [
        "Policyholders capture into their own ledger (ownership-scoped)",
        "Insurer staff read their tenant's cohort (InsurerPortfolioView)",
        "Valuers attach independent value evidence (AssetValuate)"
      ]
    },
    {
      "dot": "rose",
      "title": "Protection",
      "items": [
        "Cross-border AI enrichment needs a distinct POPIA consent",
        "InsurerTenantGuard confines insurer reads to their tenant",
        "Asset-for-sale exports are verified publicly by token"
      ]
    },
    {
      "dot": "emerald",
      "title": "Reuses Trustli rails",
      "items": [
        "Same WebApi, Postgres, MinIO and Worker as the platform",
        "Retention sweep purges ephemeral frames and their blobs",
        "Insurer tenants carry their own console branding"
      ]
    }
