  "cards": [
    {
      "dot": "emerald",
      "title": "One capture command",
      "items": [
        "AnalyzeSnap uploads the still, enriches, values and writes assets",
        "Blob upload and enrichment are an accepted at-least-once hazard in v1",
        "Assurance is derived from the append-only evidence set"
      ]
    },
    {
      "dot": "rose",
      "title": "Data protection",
      "items": [
        "Without cross-border AI consent, on-device detections are used",
        "Canonical stills are kept; ephemeral scan frames are purged",
        "Insurer reads are confined to their tenant by InsurerTenantGuard"
      ]
    },
    {
      "dot": "amber",
      "title": "Value strength",
      "items": [
        "The AI baseline rail is self-asserted and never reaches ValueSupported",
        "A professional valuation attaches independent value evidence",
        "Professional rails plug into the router without touching capture",
        "Minting an Asset Passport snapshots the ledger evidence (one per asset)"
      ]
    }
  ]
