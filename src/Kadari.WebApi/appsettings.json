{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "S3": {
    "BucketName": "kadari",
    "ForcePathStyle": true
  },
  "Verification": {
    "PerRailTimeoutSeconds": 30,
    "RailProviders": {}
  },
  "Didit": {
    "BaseUrl": "https://verification.didit.me",
    "CallbackUrl": "",
    "TimestampToleranceSeconds": 300,
    "RailWorkflows": {}
  },
  "Sumsub": {
    "BaseUrl": "https://api.sumsub.com",
    "LinkTtlSeconds": 604800,
    "RailLevels": {}
  },
  "VerifyNow": {
    "BaseUrl": "https://www.verifynow.co.za/api/external",
    "UseSandbox": true,
    "VerifyPath": "/verify",
    "CipcPath": "/cipc",
    "BankPath": "/bank-account-verification",
    "AmlPath": "/aml-screening",
    "DefaultCountry": "za"
  },
  "Osint": {
    "EnabledCollectors": []
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ReverseProxy": {
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  }
}
