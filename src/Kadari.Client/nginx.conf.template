server {
    listen      8080;
    server_name _;

    root  /usr/share/nginx/html;
    index index.html;

    # Don't advertise the nginx version (GL-20).
    server_tokens off;

    # Receipts and documents are uploaded through /api; match the API's 12 MB upload allowance so they are not
    # refused here first with a 413 (nginx's default is 1 MB). The API still enforces its own, tighter limits.
    client_max_body_size 12m;

    # Security headers and the CSP are set once, by the edge proxy in front of this container, so they are not
    # duplicated here.

    # Long-cache the fingerprinted assets Vite emits under /assets.
    location /assets/ {
        expires    1y;
        add_header Cache-Control "public, immutable";
        try_files  $uri =404;
    }

    # The shell must never be cached, or a deploy's new asset hashes are not picked up.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # No dotfiles (.git, .env, …) even if one slipped into the image.
    location ~ /\. {
        return 404;
    }

    # SPA fallback — hand unknown paths to the client-side router.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Reverse-proxy API calls to the Web API. ${API_URL} is filled from the
    # environment at container start (Aspire sets it to the webapi endpoint).
    # A variable proxy_pass + Docker's embedded resolver means the container
    # still starts even if the upstream isn't ready yet. In production the edge
    # proxy routes /api straight to the API, so this is the local/Aspire path.
    location /api/ {
        resolver 127.0.0.11 valid=30s;
        set $upstream ${API_URL};
        proxy_pass         $upstream;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }
}
